{
  // Supercalifragilisticex on Cloudflare Workers (webhook + Cron Trigger + Supabase via Hyperdrive). Replaces bot.py on Zeabur.
  // Data: schema supercal in the shared Supabase project (TheBooleanJulian/thebooleanjulian-db). The Hyperdrive config
  // "supercal-db" logs in as supercal_app, which can only touch that schema.
  // Model calls: thebooleanjulian-llm service binding (use cases event-extract / event-extract-vision). No provider keys here.
  // Secrets: BOT_TOKEN, WEBHOOK_SECRET, GOOGLE_TOKEN_JSON, ALLOWED_USER_IDS (and optionally MORNING_BRIEF_CHAT_ID).
  // Cutover (see README "Cutover"): fill in the Hyperdrive id and uncomment `hyperdrive` + `routes`, push secrets, deploy,
  // then setWebhook and suspend the Zeabur poller right away (both would otherwise fight over getUpdates).
  "name": "supercalifragilisticex",
  "account_id": "c580c4403524273d1bece674117472dd",
  "main": "worker.js",
  // Workers Builds / the bot-core fan-out track bot-core @main; the fan-out sets BOT_CORE_SHA and installs that commit itself.
  "build": {
    "command": "node -e \"process.env.BOT_CORE_SHA || require('child_process').execSync('npm install --no-save --no-audit --no-fund github:TheBooleanJulian/thebooleanjulian-bot-core#main', { stdio: 'inherit' })\""
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "BOT_USERNAME": ""
  },
  "services": [{ "binding": "LLM", "service": "thebooleanjulian-llm" }],
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<from provision.mjs supercal>" }],
  "triggers": { "crons": ["0 23 * * *"] }, // 07:00 SGT morning brief
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/webhook", "/healthz", "/status", "/brand/*"]
  },
  // "routes": [{ "pattern": "supercalifragilisticex.thebooleanjulian.dev", "custom_domain": true }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
