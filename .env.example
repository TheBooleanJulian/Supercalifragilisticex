# Telegram
TELEGRAM_BOT_TOKEN=7xxxxxxxxx:AAFxxx...

# Your Telegram user ID — find via @userinfobot
# Comma-separated for multiple users. Leave blank to allow everyone.
ALLOWED_USER_IDS=123456789

# Google AI Studio (primary extractor — Gemini 3.1 Flash-Lite)
# Free tier: 15 RPM / 1500 RPD. Get key at https://aistudio.google.com
GEMINI_API_KEY=AIza...

# Anthropic (fallback extractor — Claude Haiku 4.5)
ANTHROPIC_API_KEY=sk-ant-...

# Google Calendar OAuth token
# Local dev:  leave blank — bot reads token.json from disk
# Zeabur:     paste the one-liner JSON printed by auth_setup.py
